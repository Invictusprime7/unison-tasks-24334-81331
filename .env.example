# ─────────────────────────────────────────────────────────────
# Environment template. Copy to `.env` and fill in real values.
# NEVER commit `.env`. Do NOT hardcode fallbacks in source code.
# ─────────────────────────────────────────────────────────────

# Lovable Cloud / Supabase (client-safe, injected at build time)
# These are auto-provisioned by the Lovable Cloud connection.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only Supabase secret. Never expose in client bundles.
# Not available on Lovable Cloud managed projects.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (optional — Lovable AI Gateway is preferred and needs no key)
LOVABLE_API_KEY=
OPENAI_API_KEY=
VERCEL_AI_GATEWAY_KEY=

# Docker preview gateway (local dev only)
VITE_PREVIEW_GATEWAY_URL=http://localhost:3001
