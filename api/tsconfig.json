{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "outDir": ".vercel/output/functions",
    "declaration": false,
    "isolatedModules": true
  },
  "include": ["**/*", "../src/lib/inngest.ts", "../src/lib/inngest-workflows.ts"],
  "exclude": ["node_modules"]
}
